{
  "schema_version": "1.0",
  "current_registry_schema": "2.1",
  "legacy_registry_schemas": [
    "2.0"
  ],
  "run": {
    "modes": [
      {
        "key": "audit",
        "label": "AUDIT",
        "repository_writes_allowed": false,
        "live_demonstration_allowed": false,
        "description": "Inspect and report on an existing target without changing its source."
      },
      {
        "key": "redesign",
        "label": "REDESIGN",
        "repository_writes_allowed": true,
        "live_demonstration_allowed": true,
        "description": "Audit, establish a coherent direction, implement authorized source changes, and verify them."
      },
      {
        "key": "design",
        "label": "DESIGN",
        "repository_writes_allowed": true,
        "live_demonstration_allowed": true,
        "description": "Create an authorized new interface after establishing the product frame and exploring structural directions."
      },
      {
        "key": "demonstrate_fix",
        "label": "DEMONSTRATE-FIX",
        "repository_writes_allowed": false,
        "live_demonstration_allowed": true,
        "description": "Demonstrate reversible live-page changes without representing them as repository changes."
      }
    ],
    "mode_selection_basis": [
      "explicit",
      "inferred"
    ],
    "blind_statuses": [
      "not_run",
      "verified",
      "contaminated"
    ],
    "authority_states": [
      "authorized",
      "not_authorized"
    ],
    "authority_basis_types": [
      "explicit_request",
      "not_granted"
    ]
  },
  "context": {
    "schema_version": "1.2",
    "legacy_schema_versions": [
      "1.0",
      "1.1"
    ],
    "feature_schema_versions": {
      "visual_evidence": [
        "1.1",
        "1.2"
      ],
      "routing": [
        "1.2"
      ]
    },
    "product_frame_questions": [
      {
        "key": "audience",
        "label": "Who is it for?"
      },
      {
        "key": "job",
        "label": "What job does it perform?"
      },
      {
        "key": "primary_action",
        "label": "What is the primary action?"
      },
      {
        "key": "differentiator",
        "label": "What makes it meaningfully different?"
      },
      {
        "key": "return_reason",
        "label": "Why would someone return?"
      },
      {
        "key": "success_signal",
        "label": "What observable result means it succeeded?"
      }
    ],
    "product_frame_bases": [
      "observed",
      "supplied",
      "inferred",
      "mixed",
      "unknown"
    ],
    "task_statuses": [
      "pass",
      "fail",
      "partial",
      "needs_verification",
      "not_run"
    ],
    "scruffy_applicability_statuses": [
      "applicable",
      "not_applicable",
      "uncertain"
    ],
    "capabilities": [
      {
        "key": "source_read",
        "label": "Source read access"
      },
      {
        "key": "rendered_page",
        "label": "Rendered-page access"
      },
      {
        "key": "interaction_keyboard",
        "label": "Interaction and keyboard operation"
      },
      {
        "key": "screenshots",
        "label": "Screenshots or equivalent visual evidence"
      },
      {
        "key": "console_network_accessibility_performance",
        "label": "Console, network, accessibility-tree, and performance inspection"
      },
      {
        "key": "source_write",
        "label": "File write and implementation access"
      },
      {
        "key": "prior_audit_data",
        "label": "Prior audit registry, reports, and decision data"
      },
      {
        "key": "copy_context",
        "label": "Copy samples, audience, voice, and regulated-language constraints"
      },
      {
        "key": "design_reference_search",
        "label": "Design-reference search (shipped-product connector)"
      }
    ],
    "capability_statuses": [
      "available",
      "partial",
      "unavailable",
      "not_needed",
      "not_run",
      "not_authorized"
    ],
    "score_values": [
      0,
      1,
      2,
      3,
      "N/A"
    ],
    "evidence_kinds": [
      "task_observation",
      "screenshot",
      "source",
      "measurement",
      "analysis_receipt",
      "specialist_review",
      "runtime_trace",
      "accessibility_observation",
      "copy_sample",
      "supplied"
    ],
    "evidence_verification": [
      "captured",
      "observed",
      "supplied",
      "not_verified"
    ],
    "visual_annotation_statuses": [
      "provided",
      "not_needed"
    ],
    "visual_annotation_max_regions": 4,
    "review_lanes": [
      {
        "key": "core_interface",
        "label": "Core interface audit",
        "owner": "scruffy",
        "description": "The eight canonical interface categories, representative tasks, rendered states, and implementation consequences."
      },
      {
        "key": "service_journey",
        "label": "End-to-end service journey",
        "owner": "scruffy",
        "description": "Cross-channel handoffs, actors, recovery paths, and visible service gaps around the interface."
      },
      {
        "key": "media_ingestion",
        "label": "Media ingestion",
        "owner": "scruffy",
        "description": "Capture, upload, transformation, moderation, projection, download, deletion, and visible failure states for media products."
      },
      {
        "key": "shared_output",
        "label": "Shared or physical output",
        "owner": "scruffy",
        "description": "Ceremonial, projected, printed, QR, and other shared-output interface surfaces within available evidence."
      },
      {
        "key": "api_contract",
        "label": "API contract review",
        "owner": "specialist",
        "description": "API semantics, compatibility, authorization, and protocol correctness beyond observable interface consequences."
      },
      {
        "key": "security",
        "label": "Security review",
        "owner": "specialist",
        "description": "Threat modeling, vulnerability discovery, exploitability, and security severity."
      },
      {
        "key": "privacy",
        "label": "Privacy review",
        "owner": "specialist",
        "description": "Data-subject harms, minimization, retention, consent, and privacy-law analysis beyond visible interface consequences."
      },
      {
        "key": "reliability",
        "label": "Reliability and operations review",
        "owner": "specialist",
        "description": "Production availability, observability, incident response, capacity, and provider operations."
      },
      {
        "key": "legal_compliance",
        "label": "Legal and compliance review",
        "owner": "specialist",
        "description": "Legal sufficiency, jurisdiction-specific obligations, regulated claims, and policy approval."
      },
      {
        "key": "physical_testing",
        "label": "Physical and real-device testing",
        "owner": "specialist",
        "description": "Real-device, venue, lighting, distance, printer, projector, signage, and other physical acceptance evidence."
      }
    ],
    "lane_dispositions": [
      "selected",
      "rejected",
      "not_applicable",
      "referred"
    ],
    "assumption_statuses": [
      "open",
      "supported",
      "refuted"
    ],
    "assumption_confidence": [
      "high",
      "moderate",
      "low",
      "unknown"
    ],
    "referral_review_statuses": [
      "not_run",
      "partial",
      "complete"
    ],
    "ledger_revision_dispositions": [
      "new",
      "carried",
      "updated"
    ],
    "specialist_review_verification_states": [
      "verified",
      "not_verified"
    ]
  },
  "observation_manifest": {
    "schema_version": "1.0",
    "supported_versions": [
      "1.0"
    ],
    "digest_algorithm": "sha256",
    "input_roles": [
      "registry",
      "decisions",
      "results"
    ],
    "result_provenance": [
      "collected",
      "imported",
      "not_collected"
    ],
    "target_identity_kinds": [
      "git_commit",
      "directory"
    ],
    "target_fingerprint_scopes": [
      "commit_and_worktree_bytes",
      "incomplete",
      "unavailable",
      "path_only"
    ],
    "target_fingerprint_exclusions": [
      "files ignored by the target repository",
      "file modes, ownership, and timestamps",
      "submodule and nested-repository contents",
      "anything outside the recorded working directory",
      "paths the caller excluded as generated state, and the run's own receipt"
    ],
    "required_fields": [
      "manifest_version",
      "run_id",
      "tool",
      "started_at",
      "completed_at",
      "inputs",
      "target",
      "target_after",
      "target_stable",
      "target_binding",
      "execution",
      "checks_digest",
      "result_counts"
    ]
  },
  "editorial_review": {
    "review_types": [
      "sentence_pattern",
      "microcopy",
      "claims_provenance",
      "content_strategy",
      "mixed"
    ],
    "sample_adequacy": [
      "adequate",
      "limited",
      "insufficient",
      "not_applicable"
    ],
    "analysis_language_scopes": [
      "en",
      "non_en",
      "unknown",
      "not_applicable"
    ],
    "language_review_bases": [
      "verified_english_analyzer",
      "language_competent_human",
      "not_run",
      "not_applicable"
    ],
    "sentence_signal_families": [
      "rhythm",
      "rhetorical_structure",
      "discourse_structure",
      "lexical_repetition",
      "specificity",
      "responsibility",
      "cognitive_load"
    ],
    "manual_check_results": [
      "clear",
      "candidate",
      "not_run",
      "not_applicable"
    ],
    "sentence_manual_checks": [
      "conceptual_coherence",
      "sentence_portability",
      "discourse_purpose",
      "voice_and_subtext"
    ],
    "editorial_manual_checks": [
      "terminology_and_information_sequence",
      "claim_support_and_provenance",
      "action_and_recovery_clarity",
      "voice_and_audience_fit"
    ],
    "authorship_assessment": "not_performed"
  }
}
